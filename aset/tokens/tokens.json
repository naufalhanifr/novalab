{
  "$description": "NOVA Lab design tokens v1.0 (high-fi, NVA-8). Source: brand mini-kit NVA-3, approved by Founder in NVA-7 (D1). Light theme only.",
  "color": {
    "ink": "#0B0F19",
    "ink-muted": "#475467",
    "paper": "#FFFFFF",
    "surface": "#F5F6F8",
    "surface-dark": "#1D2433",
    "primary": "#3B2FD1",
    "primary-hover": "#2A1FA8",
    "primary-tint": "#EEECFF",
    "accent": "#7A6CFF",
    "on-dark": "#E4E7EC",
    "on-dark-muted": "#AAB2C0",
    "accent-on-dark": "#B8B0FF",
    "border": "#D0D5DD",
    "border-strong": "#7B8494",
    "error": "#B42318",
    "error-tint": "#FEF3F2",
    "success": "#067647",
    "success-tint": "#ECFDF3",
    "disabled-bg": "#E4E7EC",
    "disabled-fg": "#667085",
    "tbc-fg": "#93370D",
    "tbc-bg": "#FEF6EE"
  },
  "font": {
    "display": "\"Space Grotesk\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "body": "Inter, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"
  },
  "type": {
    "display": {
      "font": "display",
      "weight": 700,
      "tracking": "-0.02em",
      "mobile": [40, 48],
      "desktop": [64, 72]
    },
    "h1": {
      "font": "display",
      "weight": 700,
      "tracking": "-0.02em",
      "mobile": [32, 40],
      "desktop": [48, 56]
    },
    "h2": {
      "font": "display",
      "weight": 700,
      "tracking": "-0.01em",
      "mobile": [26, 34],
      "desktop": [36, 44]
    },
    "h3": {
      "font": "display",
      "weight": 500,
      "tracking": "0",
      "mobile": [20, 28],
      "desktop": [24, 32]
    },
    "body-lg": { "font": "body", "weight": 400, "mobile": [18, 28], "desktop": [20, 32] },
    "body": { "font": "body", "weight": 400, "mobile": [16, 24], "desktop": [16, 26] },
    "small": { "font": "body", "weight": 400, "mobile": [14, 20], "desktop": [14, 22] },
    "label": { "font": "body", "weight": 600, "mobile": [14, 20], "desktop": [14, 20] },
    "eyebrow": {
      "font": "body",
      "weight": 600,
      "tracking": "0.08em",
      "uppercase": true,
      "mobile": [12, 16],
      "desktop": [13, 16]
    },
    "button": { "font": "body", "weight": 600, "mobile": [16, 24], "desktop": [16, 24] }
  },
  "space": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80, 96, 128],
  "radius": { "sm": 4, "md": 8, "lg": 16, "full": 9999 },
  "breakpoint": { "base": 360, "md": 768, "lg": 1024, "xl": 1280 },
  "container": { "max": 1200, "margin-base": 20, "margin-md": 32, "margin-lg": 40 },
  "header-height": { "base": 64, "lg": 72 },
  "control-height": { "md": 48, "sm": 44 },
  "measure": { "prose": "68ch" },
  "focus": { "width": 2, "offset": 2, "color-light": "#3B2FD1", "color-dark": "#B8B0FF" },
  "shadow": { "sm": "0 1px 2px rgba(11,15,25,.06)", "md": "0 8px 24px rgba(11,15,25,.08)" },
  "motion": { "fast": 150, "base": 250, "easing": "cubic-bezier(.2,0,0,1)" },
  "z": { "header": 100, "menu": 200, "toast": 300 }
}
