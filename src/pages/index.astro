---
import Base from "@/layouts/Base.astro";
import { ui } from "@/i18n/ui";
const t = ui.home;
---

<Base title={t.title}>
  <main class="mx-auto max-w-3xl px-6 py-24">
    <h1 class="text-4xl font-semibold tracking-tight">{t.title}</h1>
    <p class="mt-4 text-neutral-600">{t.placeholder}</p>
  </main>
</Base>
